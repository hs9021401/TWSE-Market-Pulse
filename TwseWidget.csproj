<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TwseWidget</AssemblyName>
    <RootNamespace>TwseWidget</RootNamespace>
    <Version>0.1.1002.2026</Version>
    <AssemblyVersion>0.1.1002.2026</AssemblyVersion>
    <FileVersion>0.1.1002.2026</FileVersion>
    <InformationalVersion>0.1.1002.2026</InformationalVersion>
    <ApplicationIcon>Assets\TwseWidget.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <None Remove="Assets\TwseWidget.ico" />
    <Resource Include="Assets\TwseWidget.ico" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>
</Project>
